FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --system app && useradd --system --gid app --home-dir /app app

COPY requirements-worker.lock ./requirements-worker.lock
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-worker.lock

COPY . .
RUN chown -R app:app /app

USER app

CMD ["celery", "-A", "src.app.workers.worker_entrypoint:celery_app", "worker", "--loglevel=INFO", "--concurrency=1", "--queues=ingestion"]
