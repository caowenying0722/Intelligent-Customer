# Application runtime. APP_ENV remains supported as a compatibility alias.
APPLICATION_ENV=development
LOG_LEVEL=INFO

# Model provider. LLM__PROVIDER remains supported as a compatibility alias.
MODEL_PROVIDER=anthropic

# Moonshot/Kimi API Key
# Get your API key from https://console.moonshot.cn/
MOONSHOT_API_KEY=your_moonshot_api_key_here

# DeepSeek API Key
# Current config/rag.yml defaults to chat_base_url=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Anthropic-compatible DeepSeek gateway
# Use plain URLs in .env, not Markdown links.
ANTHROPIC_AUTH_TOKEN=your_anthropic_compatible_key_here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash

# Shared model transport safety. TLS verification is always enabled.
REQUEST_TIMEOUT_SECONDS=30
MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
# For a private CA, provide a PEM file path instead of disabling TLS verification.
# MODEL_CA_BUNDLE=config/company-ca.pem

# Agent execution must remain bounded.
AGENT_MAX_STEPS=10
AGENT_MAX_TOOL_CALLS=5

# Future API boundary. Pydantic Settings parses this JSON array.
ALLOWED_ORIGINS=["http://localhost:8501"]
API_HOST=127.0.0.1
API_PORT=8000
# PostgreSQL is optional for the in-process demo and required for durable API state.
# The Compose development stack supplies this value to the API automatically.
# DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5432/intelligent_customer
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_ISOLATION_LEVEL=READ COMMITTED
# Production API authentication. Leave unset for local development only.
# JWT_SECRET=replace-with-at-least-32-random-characters
# JWT_ISSUER=intelligent-customer-service
# JWT_AUDIENCE=intelligent-customer-clients
# Qdrant is optional for the local SQLite baseline and required for hybrid retrieval.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_TIMEOUT_SECONDS=5
# Optional cross-process ingestion. The default local backend does not need Redis/Celery.
INGESTION_WORKER_BACKEND=local
# REDIS_URL=redis://127.0.0.1:6379/0
WORKER_QUEUE=ingestion
WORKER_TASK_TIMEOUT_SECONDS=300
WORKER_LEASE_SECONDS=360
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=1
WORKER_CLAIM_LIMIT=10
# Streamlit defaults to the in-process demo. Set HTTP to use the FastAPI SSE boundary.
STREAMLIT_MODE=local
STREAMLIT_API_URL=http://127.0.0.1:8000
STREAMLIT_API_TIMEOUT_SECONDS=30
# Required in production for /metrics and /metrics/prometheus.
# METRICS_TOKEN=replace-with-a-random-value
# Optional OTLP gRPC exporter. Empty by default: no external trace calls.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example:4317
# OTEL_EXPORTER_TIMEOUT_SECONDS=5

# 或者如果使用其他兼容 OpenAI 的 API：
# OPENAI_API_KEY=your_openai_api_key_here
